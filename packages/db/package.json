{
  "name": "@syrantis/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "generate": "drizzle-kit generate --config=drizzle.config.ts",
    "migrate": "tsx src/migrate-cli.ts",
    "verify-migration-files": "tsx src/verify-migration-files/cli.ts",
    "verify-schema": "tsx src/verify/cli.ts",
    "health": "tsx src/health-cli.ts",
    "test": "tsx --test src/verify/verifier.test.ts src/verify-migration-files/verifier.test.ts src/migrate-cli.test.ts",
    "seed": "echo \"Seed is intentionally a placeholder for Issue 002.\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.27.2",
    "tsx": "^4.19.2"
  }
}
