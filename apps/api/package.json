{
  "name": "@syrantis/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "create-founder": "tsx src/cli/create-founder.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "worker:once": "tsx src/worker.ts once",
    "worker:run": "tsx src/worker.ts run",
    "worker:check": "tsx src/worker-ops.ts check",
    "worker:jobs": "tsx src/worker-ops.ts jobs",
    "worker:repair-stale": "tsx src/worker-ops.ts repair-stale"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@syrantis/db": "workspace:*",
    "@syrantis/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "tsx": "^4.19.2",
    "vitest": "^2.1.9"
  }
}
