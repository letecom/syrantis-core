{
  "name": "syrantis-core",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "type": "module",
  "scripts": {
    "dev:api": "pnpm --filter @syrantis/api dev",
    "dev:web": "pnpm --filter @syrantis/web dev",
    "test": "pnpm --filter @syrantis/db test && pnpm --filter @syrantis/shared build && pnpm --filter @syrantis/api test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.2"
  }
}
